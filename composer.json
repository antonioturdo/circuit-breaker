{
    "name": "zeusi/circuit-breaker",
    "description": "A circuit breaker for PHP with combinable opening rules on failed and slow calls, configurable half-open policies, and state shared through APCu, Redis or Memcached",
    "keywords": [
        "circuit-breaker",
        "fault-tolerance",
        "resilience",
        "sliding-window",
        "slow-calls",
        "half-open",
        "apcu",
        "redis",
        "memcached",
        "php-fpm"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Antonio Turdo",
            "homepage": "https://github.com/antonioturdo"
        }
    ],
    "homepage": "https://github.com/antonioturdo/circuit-breaker",
    "support": {
        "issues": "https://github.com/antonioturdo/circuit-breaker/issues",
        "source": "https://github.com/antonioturdo/circuit-breaker"
    },
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "ext-apcu": "Allows the usage of the APCu storage",
        "ext-memcached": "Allows the usage of the Memcached storage",
        "ext-redis": "Allows the usage of the Redis storage (phpredis)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Zeusi\\CircuitBreaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeusi\\CircuitBreaker\\Tests\\": "tests/"
        }
    }
}
